# 调试开关
DEBUG=false
# JWT 签名密钥（敏感，本地填写，无默认值）
SECRET_KEY=replace-with-local-jwt-secret
# SQLite 相对 backend/ 的路径，启动时解析为绝对路径
DATABASE_PATH=data/Customer_Service.db
# 入库成功原文目录（相对 backend/）
UPLOAD_DIR=data/uploads
# 监听地址
HOST=127.0.0.1
# 监听端口（Agent 开发 8099）
PORT=8099
# CORS：Agent 5199 与用户验收 5175
CORS_ORIGINS=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]
# 唯一内部账号用户名
INTERNAL_USERNAME=it-admin
# 内部账号种子密码（敏感，本地填写）
INTERNAL_PASSWORD=replace-with-local-password
# 登录令牌有效期（小时）
JWT_EXPIRE_HOURS=12
# 百炼 OpenAI 兼容根地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼 API Key（敏感；空则真实模型不可用，本任务不接百炼）
LLM_API_KEY=
# 对话/分类/打标模型
LLM_CHAT_MODEL=qwen-plus
# 向量模型
LLM_EMBED_MODEL=text-embedding-v3
# 向量维度，须与库内一致
LLM_EMBED_DIMENSIONS=1024
# 单次模型 HTTP 超时（秒）
LLM_TIMEOUT_SECONDS=60
# 429/超时最大重试次数
LLM_MAX_RETRIES=2
# 上传大小上限（字节，20MB）
UPLOAD_MAX_BYTES=20971520
# 单文档后台入库超时（秒）
INGEST_JOB_TIMEOUT_SECONDS=300
# 分块字符数
CHUNK_SIZE_CHARS=500
# 分块重叠字符数
CHUNK_OVERLAP_CHARS=80
# M-001 打标批次
TAG_BATCH_SIZE=8
# 单文档 FAQ 上限
FAQ_MAX_PER_DOCUMENT=20
# 抽 FAQ 原文截断
FAQ_SOURCE_MAX_CHARS=20000
# FAQ 相近余弦阈值
FAQ_SIMILARITY_THRESHOLD=0.82
# 召回条数
RETRIEVAL_TOP_K=5
# 召回最低分
RETRIEVAL_MIN_SCORE=0.45
# 当前会话上下文条数
CONTEXT_MESSAGE_LIMIT=16
# 消息输入上限
MESSAGE_MAX_CHARS=2000
# 超范围兜底文案
OUT_OF_SCOPE_TEXT=当前问题超出知识服务范围，你可以点击转人工。
# 无法回答文案
NO_KNOWLEDGE_TEXT=现有知识无法回答。你可以点击转人工。
# 等待人工文案
WAIT_HUMAN_TEXT=正在等待人工客服
# 标签体系文件（相对项目根）
TAG_TAXONOMY_PATH=docs/tag-taxonomy.json
# WebSocket 心跳（秒）
WS_HEARTBEAT_SECONDS=20
# 前端 WS 重连上限（秒）
WS_RECONNECT_MAX_SECONDS=30
